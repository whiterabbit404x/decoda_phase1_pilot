APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decoda_infra
SESSION_COOKIE=decoda_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
ADMIN_REAUTH_MINUTES=15
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=5
WORKER_POLL_SECONDS=2
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_MAX_ATTEMPTS=5
DEMO_USER_EMAIL=admin@decoda.local
DEMO_USER_PASSWORD=Decoda123!
PBKDF2_ROUNDS=120000
OIDC_ENABLED=true
OIDC_MOCK_ENABLED=true
OIDC_DEFAULT_PROVIDER_SLUG=mock-sso
OIDC_MOCK_DEFAULT_EMAIL=sso-admin@decoda.local
PUBLIC_BASE_URL=https://infra.decodasecurity.com
OIDC_REDIRECT_PATH=/api/auth/oidc/callback
TRUSTED_PROXY_COUNT=1
DEFAULT_WORKER_NAME=worker-1

WALLET_CONNECTOR_TIMEOUT_SECONDS=8
WALLET_CONNECTOR_MAX_TXS=25
